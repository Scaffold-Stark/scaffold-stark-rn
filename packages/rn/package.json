{
  "name": "@ss-rn/rn",
  "main": "./index.js",
  "version": "1.0.4",
  "overrides": {
    "chalk": "5.3.0",
    "strip-ansi": "7.1.0",
    "color-convert": "2.0.1",
    "color-name": "1.1.4",
    "is-core-module": "2.13.1",
    "error-ex": "1.3.2",
    "has-ansi": "5.0.1"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "postinstall": "patch-package",
    "test": "jest --forceExit",
    "test:watch": "jest --watchAll",
    "test:coverage": "jest --coverage --forceExit --collectCoverageFrom='hooks/scaffold-stark/**/*.ts' --collectCoverageFrom='!hooks/scaffold-stark/__tests__/**' --collectCoverageFrom='!hooks/scaffold-stark/index.ts' --collectCoverageFrom='utils/scaffold-stark/**/*.ts' --collectCoverageFrom='!utils/scaffold-stark/__tests__/**'",
    "test:hooks": "jest hooks/scaffold-stark/__tests__/ --forceExit",
    "test:utils": "jest utils/scaffold-stark/__tests__/ --forceExit",
    "test:e2e": "maestro test .maestro/",
    "format": "prettier --write .",
    "build:dev": "eas build --profile development --platform all",
    "build:preview": "eas build --profile preview --platform all",
    "build:prod": "eas build --profile production --platform all",
    "build:ios": "eas build --profile production --platform ios",
    "build:android": "eas build --profile production --platform android",
    "submit:ios": "eas submit --platform ios --profile production --latest",
    "submit:android": "eas submit --platform android --profile production --latest",
    "submit:all": "eas submit --platform all --profile production --latest",
    "update:preview": "eas update --branch preview",
    "update:production": "eas update --branch production"
  },
  "dependencies": {
    "@cavos/aegis": "^0.1.5",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.0.2",
    "@gorhom/bottom-sheet": "^5.2.6",
    "@react-navigation/bottom-tabs": "^7.3.10",
    "@react-navigation/elements": "^2.3.8",
    "@react-navigation/native": "^7.1.6",
    "@scaffold-stark/stark-burner": "^1.0.0",
    "@starknet-io/get-starknet-modal": "^5.0.0",
    "@starknet-start/chains": "^1.0.0",
    "@starknet-start/explorers": "^1.0.0",
    "@starknet-start/providers": "^1.0.0",
    "@starknet-start/react": "^1.0.0",
    "@tanstack/react-query": "^5.87.1",
    "blo": "^2.0.0",
    "expo": "^54.0.0",
    "expo-blur": "~15.0.7",
    "expo-clipboard": "~8.0.7",
    "expo-constants": "~18.0.9",
    "expo-font": "~14.0.8",
    "expo-haptics": "~15.0.7",
    "expo-image": "~3.0.8",
    "expo-linear-gradient": "^15.0.7",
    "expo-linking": "~8.0.8",
    "expo-router": "~6.0.8",
    "expo-secure-store": "^15.0.7",
    "expo-splash-screen": "~31.0.10",
    "expo-status-bar": "~3.0.8",
    "expo-symbols": "~1.0.7",
    "expo-system-ui": "~6.0.7",
    "expo-web-browser": "~15.0.7",
    "nativewind": "^4.1.23",
    "qs": "^6.14.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.4",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "^0.5.1",
    "starknet": "^9.4.2",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@expo/ngrok": "^4.1.3",
    "@tanstack/eslint-plugin-query": "^5.86.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/qs": "^6",
    "@types/react": "~19.1.10",
    "abi-wan-kanabi": "^2.2.4",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.12",
    "patch-package": "^8.0.0",
    "prettier-plugin-tailwindcss": "^0.5.14",
    "tailwindcss": "^3.4.17",
    "type-fest": "^4.6.0",
    "typescript": "~5.9.2"
  },
  "resolutions": {
    "@noble/hashes": "1.8.0"
  },
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./test/setup.ts"
    ],
    "moduleNameMapper": {
      "^@/(.*)": "<rootDir>/$1"
    },
    "transform": {
      "\\.[jt]sx?$": "babel-jest",
      "\\.mjs$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|react-native-svg|@starknet-start|@scaffold-stark|starknet|viem|abi-wan-kanabi))",
      "/node_modules/react-native-reanimated/plugin/"
    ],
    "coverageReporters": [
      "text",
      "text-summary",
      "lcov",
      "html"
    ],
    "coverageThreshold": {
      "global": {
        "statements": 85,
        "branches": 70,
        "functions": 85,
        "lines": 85
      }
    }
  },
  "private": true
}
